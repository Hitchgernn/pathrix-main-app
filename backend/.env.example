DATABASE_URL=postgresql+asyncpg://pathrix:pathrix@localhost:5432/pathrix
REDIS_URL=redis://localhost:6379/0

MAPID_BASEMAP_KEY=
MAPID_MISSION_API_KEY=
MAPID_GEOSERVER_API_KEY=
MAPID_PROJECT_ID=
MAPID_HALTE_LAYER_ID=

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Separate product/contract from the MAPID keys above — see
# docs/CLAUDE_TRANSIT_HANDOFF.md. Leave MAPID_ROUTING_ENABLED unset/false
# until a real base URL, auth method, and request/response contract are
# verified; HttpMapidRoutingClient does not exist yet for that reason.
MAPID_ROUTING_BASE_URL=
MAPID_ROUTING_API_KEY=
MAPID_ROUTING_ENABLED=false
MAPID_ROUTING_TIMEOUT_S=5

# Demo-only: returns a hand-authored Route fixture instead of the real graph.
# Never enable outside recording a demo.
DEMO_MOCK_ROUTE=false

STUDY_AREA_POLYGON=

RATE_LIMIT_PER_MINUTE=60

# Comma-separated browser origins allowed to call this API cross-origin.
CORS_ALLOW_ORIGINS=http://localhost:5173
